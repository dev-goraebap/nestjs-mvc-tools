<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CSRF Test</title>
</head>

<body>
  {{ inspect(csrfToken) }}
  <form method="post" action="/csrf-test/02">
    <!-- 테스트를 위해 숨기지 않음 -->
    <input type="text" name="_csrf" value="{{ csrfToken }}">
    <input type="text">
    <button>CSRF Test</button>
  </form>
</body>

</html>